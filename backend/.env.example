# Sanjeevani backend — environment configuration
# Copy this file to `.env` and adjust as needed. All values below are read by
# app/config.py via pydantic-settings. Nothing in this phase is required to run
# the mock server — every var has a safe dev default.

# --- Server ---
APP_ENV=dev                        # dev | staging | prod
HOST=0.0.0.0
PORT=8000

# --- Auth ---
# When REQUIRE_API_KEY=true, every request must send header `X-API-Key: <API_KEY>`.
# Defaults to false in dev so the frontend/voice team can hit endpoints with zero setup.
REQUIRE_API_KEY=false
API_KEY=changeme-dev-key

# --- CORS ---
# Comma-separated list of allowed origins. Ignored (all origins allowed) when APP_ENV=dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mock data behavior ---
# When true, a background task pushes a scripted disruption over the WS /api/v1/live
# feed every ~45s so the frontend has live data to build against.
MOCK_LIVE_REPLAY=true

# --- Future integrations (NOT wired in this phase — placeholders only) ---
# These are read by config.py for forward-compat but unused until the DB/real-logic
# phase begins. Left blank/unset is fine.
DATABASE_URL=
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
GUARDIAN_API_URL=
SUPERMEMORY_API_KEY=
VERIFICATION_API_KEY=
ORCHESTRATE_API_KEY=
