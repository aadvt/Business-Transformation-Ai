# Sanjeevani backend — environment configuration
# Copy this file to `.env` and adjust as needed. All values below are read by
# app/config.py via pydantic-settings.

# --- Server ---
APP_ENV=dev                        # dev | staging | prod
HOST=0.0.0.0
PORT=8000

# --- Auth ---
# When REQUIRE_API_KEY=true, every request must send header `X-API-Key: <API_KEY>`.
# Defaults to false in dev so the frontend/voice team can hit endpoints with zero setup.
REQUIRE_API_KEY=false
API_KEY=changeme-dev-key

# --- CORS ---
# Comma-separated list of allowed origins. Ignored (all origins allowed) when APP_ENV=dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mock/live behavior ---
# WS /api/v1/live: when true, a background task pushes a scripted disruption
# story every ~45s so the frontend has live data to build against.
MOCK_LIVE_REPLAY=true
# When true, every REST endpoint reads from the in-memory JSON-fixture store
# (Phase 1 behavior) instead of the database below. Flip to true as an
# emergency fallback if Postgres becomes unreachable (e.g. venue wifi blocks
# outbound port 5432) — see README "Offline / no-Postgres fallback".
USE_MOCKS=false

# --- Database (Phase 2) ---
# Pooled Neon connection string (hostname contains "-pooler") — used for all
# app request traffic. Get this from the Neon console; paste it verbatim,
# including sslmode=require (and channel_binding=require if present) — do not
# hand-construct it. Scheme must be postgresql+psycopg://.
DATABASE_URL=sqlite:///./sanjeevani.db
# Direct (non-pooled) Neon connection string (no "-pooler" in hostname) — used
# ONLY by `python -m app.seed`. Falls back to DATABASE_URL when unset, which is
# correct for the sqlite fallback (no pooler distinction there).
DATABASE_URL_DIRECT=

# --- LLM / watsonx.ai (Phase 3) ---
# LLM_PROVIDER: auto | watsonx | stub
#   auto    — use watsonx when credentials below are present, otherwise StubLLM
#   watsonx — force watsonx (still degrades to StubLLM if a live call fails)
#   stub    — never touch the network (what the test suite uses)
LLM_PROVIDER=auto
# Regional watsonx.ai endpoint, e.g. https://eu-de.ml.cloud.ibm.com
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
# From IBM Cloud → API keys. Never commit a real value here — put it in .env.
WATSONX_API_KEY=
# From your watsonx.ai project → Manage → General → Project ID.
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-4-h-small
WATSONX_API_VERSION=2024-05-31
WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=3

# --- Granite Guardian (Phase 3) ---
# Safety/groundedness scoring. Set GUARDIAN_ENABLED=false to skip the calls
# entirely (verdicts then come back status=UNAVAILABLE, passed=True).
GUARDIAN_MODEL_ID=ibm/granite-guardian-3-8b
GUARDIAN_ENABLED=true

# --- Future integrations (NOT wired yet — placeholders only) ---
SUPERMEMORY_API_KEY=
VERIFICATION_API_KEY=
ORCHESTRATE_API_KEY=
BOLNA_WEBHOOK_PUBLIC_URL=https://affecting-gains-thinner.ngrok-free.dev
BOLNA_WEBHOOK_SECRET=
