# Copy to .env and fill in (never commit the real .env file)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional overrides
# WATSONX_MODEL_ID=ibm/granite-4-h-small
# AUDIT_LOG_PATH=audit_log.json

# Voice channel (Bolna) — get a key from the Bolna Dashboard > Developers
BOLNA_API_KEY=
# Public base URL Bolna's tool-call webhooks reach the voice adapter on
# (e.g. an ngrok tunnel in dev, a real host in prod). Required to register
# an agent or place a real call; not required to run/test the adapter locally.
VOICE_ADAPTER_BASE_URL=https://your-public-host.example.com
# Filled in by voice/register_agent.py after it creates each agent
BOLNA_AGENT_ID=
BOLNA_NEGOTIATION_AGENT_ID=
# Where api.py is reachable from the voice adapter
TRANSACTION_AGENT_API_BASE_URL=http://127.0.0.1:8000
TRANSACTION_AGENT_API_KEY=dev-local-key

# Google Sheets logging for negotiation outcomes (voice/sheets.py). Optional —
# without these, outcomes still get recorded in the negotiations table, just
# not mirrored to a spreadsheet. GOOGLE_SERVICE_ACCOUNT_JSON is the full
# service-account key file content (not a path); see voice/setup_sheet.py
# to create and share a fresh sheet with these credentials.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# NEGOTIATION_SPREADSHEET_ID=

# Neon Postgres. When set, audit/recipients/users/checkpoints all move from
# local SQLite/JSON files to this database (schema "transaction_agent" —
# created automatically on first use; kept separate from any other
# service's tables in "public"). Leave unset for local/offline dev, which
# keeps using SQLite/JSON files with zero external dependencies.
# DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
# DATABASE_URL_DIRECT=postgresql://user:pass@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
